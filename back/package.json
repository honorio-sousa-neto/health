  "type": "commonjs",
  "scripts": {
    "start:dev": "node --watch -r ts-node/register src/index.ts",
    "start": "node build/index.js",
    "build": "npx tsc --project tsconfig.json",
    "seed": "node prisma/seed-all.js",
    "seed:list": "node prisma/seed-all.js --list",
    "seed:consumo-padrao": "node prisma/seed-consumo-padrao.js",
    "seed:consumo-padrao:dry": "node prisma/seed-consumo-padrao.js --dry-run",
    "deploy": "bash scripts/deploy.sh",
    "test": "node --test -r ts-node/register/transpile-only tests/security.test.cjs",
    "test:integration": "node --test -r ts-node/register/transpile-only tests/integration.test.cjs",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:push": "prisma db push"
  },
  "keywords": [],
