enum ExamResultInput {
    RADIO
    SELECT
    TEXT
}


model Payment {
    id        String    @id @default(uuid()) @db.Uuid
    name      String
    code      String
    Invoice   Invoice[]
    createdAt DateTime  @default(now())
    updatedAt DateTime  @updatedAt
    deletedAt DateTime?
}

model InvoiceItem {
    id        String  @id @default(uuid()) @db.Uuid
    serviceId String  @db.Uuid
    invoiceId String  @db.Uuid
    quantity  Int
    price     Float
    discount  Float
    total     Float
    config    Json?
    service   Service @relation(fields: [serviceId], references: [id])
    invoice   Invoice @relation(fields: [invoiceId], references: [id])

    @@index([serviceId, invoiceId], name: "invoice-item")
}

model Invoice {
    id              String        @id @default(uuid()) @db.Uuid
    customerId      String?       @db.Uuid
    customer        Customer?     @relation(fields: [customerId], references: [id])
    type            InvoiceType
    paymentId       String?       @db.Uuid
    payment         Payment?      @relation(fields: [paymentId], references: [id])
    serie           String
    amount_received Float?
    co_payment      Float?
    invoiceItems    InvoiceItem[]
    reasonInssuance String?
    change          Float?
    isAmbulatory    Boolean       @default(false)
    reference       String
    emission_date   DateTime?     @default(now())
    expiry_date     DateTime?
    hash64          String
    hash4           String
    total           Float?
    asNormal        Boolean       @default(false)
    status          InvoiceStatus
    discount        Float?
    userId          String        @db.Uuid
    user            User          @relation(fields: [userId], references: [id])
    invoiceId       String?       @unique @db.Uuid
    insuranceId     String?
    protocolId      String?
    partnerId       String?
    internId        String?
    attendanceId    String?       @db.Uuid
    attendance      Attendance?   @relation(fields: [attendanceId], references: [id])
    invoiceSource   Invoice?      @relation("Origin", fields: [invoiceId], references: [id], onDelete: NoAction, onUpdate: NoAction)
    invoiceCurrent  Invoice?      @relation("Origin")
    createdAt       DateTime      @default(now())
    updatedAt       DateTime      @updatedAt
    deletedAt       DateTime?
}

model BankAccount {
    id        String     @id @default(uuid()) @db.Uuid
    name      String
    iban      String
    number    String
    Company   Company?   @relation(fields: [companyId], references: [id])
    companyId String?    @db.Uuid
    Deposit   Deposit[]
    purchases Purchase[]
}

model Company {
    id             String        @id @default(uuid()) @db.Uuid
    name           String
    nif            String
    email          String?
    phone          String?
    address        String?
    bank           String?
    iban           String?
    account_number String?
    banks          BankAccount[]
    tax_ii         Float?
    logo           String?
    createdAt      DateTime      @default(now())
    updatedAt      DateTime      @updatedAt
    deletedAt      DateTime?
}

model Partner {
    id        String     @id @default(uuid()) @db.Uuid
    name      String
    nif       String
    phone     String?
    address   String?
    email     String?
    customer  Customer[]
    createdAt DateTime   @default(now())
    updatedAt DateTime   @updatedAt
    deletedAt DateTime?
}

model Supplier {
    id        String     @id @default(uuid()) @db.Uuid
    name      String
    nif       String
    phone     String?
    address   String?
    email     String?
    purchases Purchase[]
    createdAt DateTime   @default(now())
    updatedAt DateTime   @updatedAt
    deletedAt DateTime?
}

enum StatusService {
    AVAILABLE
    UNAVAILABE
}

enum InvoiceType {
    RC
    FT
    FR
    ND
    NC
    PP
}

enum InvoiceStatus {
    POR_PAGAR
    PAGO
    FINAL
}

enum Measure {
    Mililitro
    Litro
    Unidade
    Par
}

model Drugs {
    id        String    @id @default(uuid()) @db.Uuid
    name      String
    tax       Float
    amount    Float
    createdAt DateTime  @default(now())
    updatedAt DateTime  @updatedAt
    deletedAt DateTime?
}

model Category {
    id                       String               @id @default(uuid()) @db.Uuid
    name                     String
    category                 Category?            @relation("SubCategories", fields: [categoryId], references: [id])
    subCategories            Category[]           @relation("SubCategories")
    categoryId               String?              @db.Uuid
    createdAt                DateTime             @default(now())
    updatedAt                DateTime             @updatedAt
    deletedAt                DateTime?
    Service                  Service[]
    ServiceIntern            ServiceIntern[]
    MovimentationStockSource MovimentationStock[] @relation("Source")
    MovimentationStock       MovimentationStock[] @relation("Destination")
}

enum Role {
    admin
    nurse
    attendant
    analyst
    doctor
    financial
    techLab
    chiefLab
    techNursian
    inventory
}

enum TransactionType {
    ADD
    SUBTRACT
}

model Flow {
    id          String     @id @default(uuid()) @db.Uuid
    destination String
    description String
    amount      Float
    type        EntryOrOut @default(ENTRY)
    createdAt   DateTime   @default(now())
}

model PurchaseItem {
    id               String         @id @default(uuid()) @db.Uuid
    Purchase         Purchase?      @relation(fields: [purchaseId], references: [id])
    purchaseId       String?        @db.Uuid
    quantity         Float
    unit             UnitOfMeasure? @relation(fields: [unitId], references: [id])
    unitId           String?        @db.Uuid
    conversionFactor Float          @default(1)
    price            Float?
    product          Service        @relation(fields: [productId], references: [id])
    productId        String         @db.Uuid
    createdAt        DateTime       @default(now())
    batch            String?
    expiration       DateTime?
}

model Purchase {
    id            String         @id @default(uuid()) @db.Uuid
    Supplier      Supplier?      @relation(fields: [supplierId], references: [id])
    supplierId    String?        @db.Uuid
    code          String?
    // Data da factura do fornecedor. `createdAt` continua a ser o momento do
    // registo: são coisas diferentes e a ordem do custo médio depende desta.
    date          DateTime?
    items         PurchaseItem[]
    other         String?
    BankAccount   BankAccount?   @relation(fields: [bankAccountId], references: [id])
    bankAccountId String?        @db.Uuid
    bank          String?
    amount        Float
    invoice       String?
    createdAt     DateTime       @default(now())
    deletedAt     DateTime?
}

model Deposit {
    id            String      @id @default(uuid()) @db.Uuid
    bank          BankAccount @relation(fields: [bankAccountId], references: [id])
    bankAccountId String      @db.Uuid
    amount        Float
    createdAt     DateTime    @default(now())
    deletedAt     DateTime?
}


model Notification {
    id          String   @id @default(uuid()) @db.Uuid
    title       String
    message     String
    type        String
    patientName String?
    reference   String?
    room        String
    readBy      String[] @default([])
    createdAt   DateTime @default(now())
}

model AmbulatoryPlan {
    id             String              @id @default(uuid()) @db.Uuid
    prescriptionId String              @unique @db.Uuid
    customerId     String              @db.Uuid
    customer       Customer            @relation(fields: [customerId], references: [id])
    prescription   Prescription        @relation(fields: [prescriptionId], references: [id])
    sessions       AmbulatorySession[]
    createdAt      DateTime            @default(now())
    updatedAt      DateTime            @updatedAt
}

model AmbulatorySession {
    id        String          @id @default(uuid()) @db.Uuid
    planId    String          @db.Uuid
    serviceId String          @db.Uuid
    number    Int
    day       Int             @default(1)
    timeOfDay Int             @default(1)
    plan      AmbulatoryPlan  @relation(fields: [planId], references: [id])
    service   Service         @relation(fields: [serviceId], references: [id])
    doneAt    DateTime?
    doneById  String?         @db.Uuid
    doneBy    User?           @relation(fields: [doneById], references: [id])
    createdAt DateTime        @default(now())
}
